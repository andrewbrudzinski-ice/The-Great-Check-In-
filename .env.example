# Leave both empty to run in local demo mode (no backend, data in localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: custom map tiles (defaults to Esri dark gray, no key needed).
# NEXT_PUBLIC_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/256/{z}/{x}/{y}@2x?access_token=YOUR_TOKEN
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© Mapbox © OpenStreetMap
# NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=20
